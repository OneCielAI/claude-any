{
  "name": "@oneciel-ai/claude-any",
  "version": "0.1.80",
  "description": "Claude Code provider selector for Anthropic, Ollama, Ollama Cloud, vLLM, NVIDIA hosted, and self-hosted NIM.",
  "license": "MIT",
  "author": "One Ciel LLC",
  "homepage": "https://github.com/OneCielAI/claude-any#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OneCielAI/claude-any.git"
  },
  "bugs": {
    "url": "https://github.com/OneCielAI/claude-any/issues"
  },
  "type": "commonjs",
  "bin": {
    "claude-any": "npm-bin/claude-any.js",
    "claude-anyctl": "npm-bin/claude-anyctl.js",
    "claude-any-stop": "npm-bin/claude-any-stop.js"
  },
  "files": [
    "claude_any.py",
    "claude_any_support/*.py",
    "claude-any",
    "claude-any.cmd",
    "claude-any.ps1",
    "claude-any-menu.py",
    "claude-any-tool-guard.py",
    "claude-anyctl",
    "claude-anyctl.cmd",
    "claude-anyctl.ps1",
    "claude-any-stop",
    "claude-any-stop.cmd",
    "claude-any-stop.ps1",
    "npm-bin/",
    "install.sh",
    "install.ps1",
    "README.md",
    "logo.png",
    "logo-small.png",
    "claude-any-adv.png",
    "LICENSE",
    "NOTICE",
    "docs/"
  ],
  "scripts": {
    "test": "python -m py_compile claude_any.py claude_any_support/__init__.py claude_any_support/observability.py claude_any_support/transcript_filter.py claude-any-menu.py claude-any-tool-guard.py scripts/make_demo_assets.py && python -m unittest discover -s tests -p \"test_*.py\"",
    "lint": "python -m ruff check .",
    "demo:assets": "python scripts/make_demo_assets.py"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18"
  }
}
